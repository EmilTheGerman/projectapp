<Window
    x:Class="passwordmanager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Password Manager"
    Width="1000"
    Height="600"
    Background="{DynamicResource CardBrush}"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="#6C63FF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Styles" TargetType="TextBox">

            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />

        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="BorderBrush" Value="#1E1E2E" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Opacity="0.1" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">

            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />

            <Setter Property="Background" Value="{DynamicResource CardBrush}" />

            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Height" Value="35" />

            <Setter Property="Padding" Value="10,0" />

            <Setter Property="FontSize" Value="14" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <Border
                                x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">

                                <Grid>

                                    <ToggleButton
                                        x:Name="ToggleButton"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Focusable="False"
                                        Foreground="{DynamicResource TextBrush}"
                                        IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="35" />
                                            </Grid.ColumnDefinitions>


                                            <ContentPresenter
                                                Grid.Column="0"
                                                Margin="12,0,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Content="{TemplateBinding SelectionBoxItem}"
                                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextBrush}"
                                                Text="▼" />

                                        </Grid>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup
                                Name="Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Fade">

                                <Border
                                    Margin="0,5,0,0"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">

                                    <ScrollViewer>

                                        <StackPanel IsItemsHost="True" />

                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="MainPanel">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Background="{DynamicResource CardBrush}">

                <TextBlock
                    Margin="10"
                    FontSize="16"
                    Foreground="{DynamicResource TextBrush}"
                    Text="Password Manager" />

                <Button
                    x:Name="BtnAll"
                    Height="20"
                    Click="ShowMain_Click"
                    Content="Усі записи" />
                <Button
                    Height="20"
                    Click="ShowCategories_Click"
                    Content="Категорії" />
                <Button
                    Height="20"
                    Click="ShowGenerator_Click"
                    Content="Генератор" />
                <Button
                    x:Name="BtnSettings"
                    Height="20"
                    Click="ShowSettings_Click"
                    Content="Налаштування" />

            </StackPanel>

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Background="{DynamicResource CardBrush}">
                    <Border
                        Width="280"
                        Height="38"
                        Margin="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="18">

                        <Grid>

                            <TextBlock
                                x:Name="SearchPlaceholder"
                                Margin="15,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource SubTextBrush}"
                                IsHitTestVisible="False"
                                Text="Пошук..." />

                            <TextBox
                                x:Name="SearchBox"
                                Margin="12,0,12,0"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                CaretBrush="{DynamicResource TextBrush}"
                                FontSize="14"
                                Foreground="{DynamicResource TextBrush}"
                                TextChanged="SearchBox_TextChanged" />

                        </Grid>
                    </Border>
                    <Button
                        Width="140"
                        Height="30"
                        Margin="10"
                        HorizontalAlignment="Right"
                        Click="NewRecord_Click"
                        Content="+ Новий запис" />
                </Grid>

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Margin="10,24,10,-4"
                        Background="{DynamicResource BgBrush}"
                        Style="{StaticResource Card}">
                        <ListBox
                            x:Name="PasswordList"
                            Background="{DynamicResource CardBrush}"
                            BorderThickness="0"
                            SelectionChanged="PasswordList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="5"
                                        Padding="8"
                                        Background="{DynamicResource BgBrush}"
                                        CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource TextBrush}"
                                                Text="{Binding Title}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource TextBrush}"
                                                Text="{Binding Login}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource TextBrush}"
                                                Text="{Binding Category}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Border
                        x:Name="DetailsPanel"
                        Grid.Column="1"
                        Background="{DynamicResource CardBrush}"
                        Style="{StaticResource Card}"
                        Visibility="Collapsed">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextBrush}"
                                    Text="Дані запису" />
                                <Button
                                    Width="30"
                                    Height="30"
                                    HorizontalAlignment="Right"
                                    Click="CloseDetails_Click"
                                    Content="✕" />
                            </Grid>
                            <StackPanel Grid.Row="1">

                                <TextBlock Foreground="{DynamicResource TextBrush}" Text="Назва" />
                                <Border
                                    Margin="0,0,0,10"
                                    Background="{DynamicResource BgBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18">

                                    <TextBox
                                        x:Name="TitleBox"
                                        Margin="12,0"
                                        Style="{StaticResource Styles}" />

                                </Border>

                                <TextBlock Foreground="{DynamicResource TextBrush}" Text="Логін" />
                                <Border
                                    Margin="0,0,0,10"
                                    Background="{DynamicResource BgBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18">

                                    <TextBox
                                        x:Name="LoginBox"
                                        Margin="12,0"
                                        Style="{StaticResource Styles}" />

                                </Border>

                                <TextBlock Foreground="{DynamicResource TextBrush}" Text="Пароль" />
                                <Border
                                    Margin="0,0,0,10"
                                    Background="{DynamicResource BgBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="45" />
                                        </Grid.ColumnDefinitions>

                                        <PasswordBox
                                            x:Name="PasswordBox"
                                            Margin="12,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource TextBrush}" />

                                        <TextBox
                                            x:Name="PasswordTextBox"
                                            Margin="12,0"
                                            Style="{StaticResource Styles}"
                                            Visibility="Collapsed" />

                                        <Button
                                            Grid.Column="1"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="TogglePassword_Click"
                                            Content="👁"
                                            Foreground="{DynamicResource TextBrush}" />

                                    </Grid>

                                </Border>

                                <TextBlock Foreground="{DynamicResource TextBrush}" Text="Категорія" />
                                <ComboBox x:Name="CategoryBox" Margin="5">

                                    <ComboBoxItem Content="Соцмережі" Foreground="{DynamicResource SubTextBrush}" />
                                    <ComboBoxItem Content="Пошта" Foreground="{DynamicResource SubTextBrush}" />
                                    <ComboBoxItem Content="Робота" Foreground="{DynamicResource SubTextBrush}" />
                                    <ComboBoxItem Content="Банкінг" Foreground="{DynamicResource SubTextBrush}" />
                                    <ComboBoxItem Content="Ігри" Foreground="{DynamicResource SubTextBrush}" />
                                    <ComboBoxItem Content="Навчання" Foreground="{DynamicResource SubTextBrush}" />
                                    <ComboBoxItem Content="Покупки" Foreground="{DynamicResource SubTextBrush}" />
                                    <ComboBoxItem Content="Хмарні сервіси" Foreground="{DynamicResource SubTextBrush}" />
                                    <ComboBoxItem Content="Інше" Foreground="{DynamicResource SubTextBrush}" />

                                </ComboBox>

                                <TextBlock Foreground="{DynamicResource TextBrush}" Text="Опис" />
                                <Border
                                    Margin="0,0,0,10"
                                    Background="{DynamicResource BgBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18">

                                    <TextBox
                                        x:Name="DescriptionBox"
                                        Height="90"
                                        Padding="10"
                                        VerticalContentAlignment="Top"
                                        AcceptsReturn="True"
                                        Style="{StaticResource Styles}"
                                        TextWrapping="Wrap" />
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Width="100"
                                        Height="25"
                                        Background="{DynamicResource AccentBrush}"
                                        Click="Save_Click"
                                        Content="Зберегти" />

                                    <Button
                                        Width="100"
                                        Background="#FF4757"
                                        Click="Delete_Click"
                                        Content="Видалити" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>

            </Grid>

        </Grid>
        <Grid x:Name="GeneratorPanel" Visibility="Collapsed">

            <Border
                Width="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource Card}">

                <StackPanel>

                    <TextBlock
                        Margin="5"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="Генератор паролів" />

                    <TextBlock Text="Довжина:" />
                    <Slider
                        x:Name="LengthSlider"
                        Maximum="32"
                        Minimum="6"
                        Value="12" />

                    <StackPanel Orientation="Horizontal">
                        <CheckBox
                            x:Name="UpperCheck"
                            Content="A-Z"
                            IsChecked="True" />
                        <CheckBox
                            x:Name="LowerCheck"
                            Content="a-z"
                            IsChecked="True" />
                        <CheckBox
                            x:Name="DigitCheck"
                            Content="0-9"
                            IsChecked="True" />
                        <CheckBox
                            x:Name="SymbolCheck"
                            Content="@#!$"
                            IsChecked="True" />
                    </StackPanel>

                    <TextBox
                        x:Name="GeneratedPasswordBox"
                        Height="35"
                        Margin="0,10"
                        HorizontalContentAlignment="Center"
                        FontSize="16" />

                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button Click="Generate_Click" Content="Згенерувати" />
                        <Button Click="Copy_Click" Content="Копіювати" />
                    </StackPanel>

                    <Button
                        Background="#57606f"
                        Click="ShowMain_Click"
                        Content="Назад" />

                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="CategoriesPanel" Visibility="Collapsed">

            <Border
                Width="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource Card}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="5" Background="{DynamicResource CardBrush}">

                        <TextBlock
                            Margin="5"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="Категорії" />

                        <Button Click="Category_Click" Content="Соцмережі" />
                        <Button Click="Category_Click" Content="Пошта" />
                        <Button Click="Category_Click" Content="Робота" />

                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10">

                        <TextBlock
                            x:Name="CategoryTitle"
                            Margin="5"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="Оберіть категорію" />

                        <ListBox
                            x:Name="CategoryList"
                            BorderThickness="0"
                            SelectionChanged="CategoryList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="5"
                                        Padding="8"
                                        Background="{DynamicResource CardBrush}"
                                        CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" Text="{Binding Title}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="Gray"
                                                Text="{Binding Login}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button
                            Background="#57606f"
                            Click="ShowMain_Click"
                            Content="Назад" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="SettingsPanel" Visibility="Collapsed">

            <Border
                Width="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource BgBrush}"
                Style="{StaticResource Card}">

                <StackPanel>

                    <TextBlock
                        Margin="5"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextBrush}"
                        Text="Налаштування" />

                    <TextBlock Foreground="{DynamicResource TextBrush}" Text="Тема" />
                    <ComboBox x:Name="ThemeBox" Margin="5">
                        <ComboBoxItem Content="Світла" />
                        <ComboBoxItem Content="Темна" />
                    </ComboBox>

                    <Button
                        Height="30"
                        Margin="0,10,0,0"
                        Click="ApplySettings_Click"
                        Content="Застосувати" />

                    <Button
                        Height="30"
                        Margin="0,10,0,0"
                        Background="#57606f"
                        Click="ShowMain_Click"
                        Content="Назад" />
                    <Button
                        Height="30"
                        Margin="0,10,0,0"
                        Background="#FF4757"
                        Click="Logout_Click"
                        Content="Вийти з акаунта" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
