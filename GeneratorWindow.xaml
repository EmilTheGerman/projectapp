<Window
    x:Class="passwordmanager.GeneratorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Генератор"
    Width="500"
    Height="450"
    Background="{DynamicResource BgBrush}"
    WindowStartupLocation="CenterOwner">

    <Border
        Width="450"
        Margin="15"
        Padding="20"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{DynamicResource CardBrush}"
        CornerRadius="18">

        <StackPanel>

            <Grid Margin="0,0,0,15">

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextBrush}"
                    Text="Генератор паролів" />

                <Button
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Right"
                    Background="#6C63FF"
                    BorderThickness="0"
                    Click="Close_Click"
                    Content="✕"
                    Cursor="Hand"
                    FontWeight="Bold"
                    Foreground="White" />
            </Grid>

            <TextBlock
                Margin="5"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextBrush}"
                Text="Довжина пароля" />

            <Border
                Margin="0,0,0,15"
                Padding="10"
                Background="{DynamicResource BgBrush}"
                CornerRadius="12">

                <StackPanel>

                    <Slider
                        x:Name="LengthSlider"
                        IsSnapToTickEnabled="True"
                        Maximum="32"
                        Minimum="6"
                        TickFrequency="1"
                        Value="12" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{DynamicResource AccentBrush}"
                        Text="{Binding ElementName=LengthSlider, Path=Value, StringFormat={}{0:F0}}" />

                </StackPanel>

            </Border>

            <TextBlock
                Margin="5"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextBrush}"
                Text="Типи символів" />

            <WrapPanel Margin="0,0,0,15">

                <CheckBox
                    x:Name="UpperCheck"
                    Margin="5"
                    Content="A-Z"
                    Foreground="{DynamicResource TextBrush}"
                    IsChecked="True" />

                <CheckBox
                    x:Name="LowerCheck"
                    Margin="5"
                    Content="a-z"
                    Foreground="{DynamicResource TextBrush}"
                    IsChecked="True" />

                <CheckBox
                    x:Name="DigitCheck"
                    Margin="5"
                    Content="0-9"
                    Foreground="{DynamicResource TextBrush}"
                    IsChecked="True" />

                <CheckBox
                    x:Name="SymbolCheck"
                    Margin="5"
                    Content="@#!$"
                    Foreground="{DynamicResource TextBrush}"
                    IsChecked="True" />

            </WrapPanel>

            <TextBlock
                Margin="5"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextBrush}"
                Text="Згенерований пароль" />

            <Border
                Margin="0,0,0,15"
                Padding="5"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="12">

                <TextBox
                    x:Name="ResultBox"
                    HorizontalContentAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextBrush}" />
            </Border>

            <Grid Margin="0,10,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Height="40"
                    Margin="5"
                    Background="{DynamicResource AccentBrush}"
                    BorderThickness="0"
                    Click="Generate_Click"
                    Content="Згенерувати"
                    Cursor="Hand"
                    FontWeight="SemiBold"
                    Foreground="White" />

                <Button
                    Grid.Column="1"
                    Height="40"
                    Margin="5"
                    Background="#2ED573"
                    BorderThickness="0"
                    Click="Use_Click"
                    Content="Використати"
                    Cursor="Hand"
                    FontWeight="SemiBold"
                    Foreground="White" />

            </Grid>
        </StackPanel>
    </Border>
</Window>