<Window x:Class="passwordmanager.CategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Категорії"
        Height="400"
        Width="600"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    
    <Window.Resources>

        <Style x:Key="CategoryButtonStyle" TargetType="Button">

            <Setter Property="Margin" Value="5"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="10">

                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Background="{DynamicResource BgBrush}">
            <Button Content="Соцмережі" Click="Category_Click" Style="{StaticResource CategoryButtonStyle}"/>
            <Button Content="Пошта" Click="Category_Click" Style="{StaticResource CategoryButtonStyle}"/>
            <Button Content="Робота" Click="Category_Click" Style="{StaticResource CategoryButtonStyle}"/>
            <Button Content="Банкінг" Click="Category_Click" Style="{StaticResource CategoryButtonStyle}"/>
            <Button Content="Ігри" Click="Category_Click" Style="{StaticResource CategoryButtonStyle}"/>
            <Button Content="Навчання" Click="Category_Click" Style="{StaticResource CategoryButtonStyle}"/>
            <Button Content="Покупки" Click="Category_Click" Style="{StaticResource CategoryButtonStyle}"/>
            <Button Content="Хмарні сервіси" Click="Category_Click" Style="{StaticResource CategoryButtonStyle}"/>
            <Button Content="Інше" Click="Category_Click" Style="{StaticResource CategoryButtonStyle}"/>
        </StackPanel>

        <Border Grid.Column="1"
                Background="{DynamicResource CardBrush}"
                CornerRadius="10"
                Margin="10">

            <StackPanel Margin="10">

                <TextBlock x:Name="CategoryTitle"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="16"
                           FontWeight="Bold"/>

                <ListBox x:Name="CategoryList"
                         SelectionChanged="CategoryList_SelectionChanged"
                         Background="{DynamicResource CardBrush}"
                         BorderBrush="{DynamicResource BgBrush}">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BgBrush}"
                                    Margin="5"
                                    Padding="8"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Login}"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </StackPanel>
        </Border>
    </Grid>
</Window>